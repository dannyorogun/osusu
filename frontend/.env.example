# Copy to .env.local (development) or set in the deployment environment
# (staging / production). NEVER put secrets in NEXT_PUBLIC_* variables:
# they are inlined into the JavaScript sent to every browser.

# Django API origin as seen by the BROWSER (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Django API origin as seen by the Next.js SERVER (session route
# handlers). Optional: defaults to NEXT_PUBLIC_API_URL. Server-only.
OSUSU_API_URL=

# This app's public origin, e.g. https://app.example.org. REQUIRED behind a
# reverse proxy (staging/production): the session routes compare the
# browser's Origin with it, and `next start` only knows its internal
# address. Unset in development (falls back to the request origin).
# Server-only.
OSUSU_APP_ORIGIN=

# Refresh-token cookie lifetime in seconds. Keep equal to Django's
# SIMPLE_JWT REFRESH_TOKEN_LIFETIME (default: 1 day). Server-only.
OSUSU_REFRESH_COOKIE_MAX_AGE=86400
