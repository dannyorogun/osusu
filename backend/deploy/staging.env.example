# Osusu STAGING backend environment. A template: copy to the host's secret
# store / environment file (mode 600, outside the repository). Never commit
# real values. See OPERATIONS.md, "Staging".

# --- Django core -----------------------------------------------------------
DJANGO_DEBUG=false
# python -c "import secrets; print(secrets.token_urlsafe(64))"  (unique per environment)
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.staging.example.org
DJANGO_STATIC_ROOT=/srv/osusu/static

# --- Browser origins (exact https origins, no wildcard or trailing slash) ---
DJANGO_CORS_ALLOWED_ORIGINS=https://staging.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.staging.example.org

# --- HTTPS behind ONE TLS proxy on the same host ----------------------------
# The proxy must overwrite X-Forwarded-Proto and set X-Forwarded-For to the
# real client address (deploy/Caddyfile.staging does both).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_NUM_PROXIES=1
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Database (staging database only; never production data) ---------------
DB_NAME=osusu_staging
DB_USER=osusu_staging
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Money: everything off --------------------------------------------------
OSUSU_PAYOUT_PROVIDER=disabled        # "mock" refuses to start here
OSUSU_MOCK_PAYMENTS_ENABLED=false     # "true" refuses to start here
OSUSU_MOCK_WEBHOOK_SECRET=

# --- Assistant: off (no paid providers, no Redis) ---------------------------
OSUSU_LLM_PROVIDER=disabled
OSUSU_EMBEDDING_PROVIDER=hashing

# --- Throttles (defaults shown) ---------------------------------------------
OSUSU_THROTTLE_LOGIN_USERNAME=5/minute
OSUSU_THROTTLE_LOGIN_IP=60/minute
OSUSU_THROTTLE_REGISTER_IP=10/hour
