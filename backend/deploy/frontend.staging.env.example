# Osusu STAGING frontend (Next.js) environment. Template only.
# NEXT_PUBLIC_* values are inlined at BUILD time: build once per environment
# (`NEXT_PUBLIC_API_URL=... npm run build`), never reuse a build across
# environments.
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.staging.example.org
# Server-side session routes -> Django. May be the same public URL.
OSUSU_API_URL=https://api.staging.example.org
# REQUIRED behind the proxy: the app's public origin. Without it every
# login/refresh/logout is refused (403) because `next start` only knows its
# internal address.
OSUSU_APP_ORIGIN=https://staging.example.org
OSUSU_REFRESH_COOKIE_MAX_AGE=86400
