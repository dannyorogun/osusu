# Copy to .env and fill in real values. Never commit .env.

# Django. DEBUG is OFF unless DJANGO_DEBUG=true. Without DEBUG the app
# refuses to start unless DJANGO_SECRET_KEY is set (it also signs JWTs);
# generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=true                 # development only
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=             # comma-separated, e.g. api.example.com

# Production security (ignored with DJANGO_DEBUG=true, except CORS).
# See OPERATIONS.md "Production deployment".
DJANGO_CORS_ALLOWED_ORIGINS=      # exact https origins of the frontend; dev default: http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=      # https origins for Django admin form posts
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_TRUST_X_FORWARDED_PROTO=false   # true only behind a proxy that overwrites it
# DJANGO_NUM_PROXIES=0                    # trusted proxies appending X-Forwarded-For
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false

# Authentication throttles (429 with Retry-After when exceeded).
# OSUSU_THROTTLE_LOGIN_USERNAME=5/minute
# OSUSU_THROTTLE_LOGIN_IP=60/minute
# OSUSU_THROTTLE_REGISTER_IP=10/hour

# Payout provider. "mock" (development default) records payouts as PAID
# without moving money and refuses to start without DJANGO_DEBUG=true.
# "disabled" (production default) refuses execution. No live provider
# is integrated.
# OSUSU_PAYOUT_PROVIDER=mock

DB_NAME=osusu
DB_USER=osusu
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Mock payment provider — development/test only. Refuses to start when
# enabled without DJANGO_DEBUG=true. When enabled, the secret must be at least 32 characters;
# generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OSUSU_MOCK_PAYMENTS_ENABLED=false
OSUSU_MOCK_WEBHOOK_SECRET=change-me-in-development

# Explanation assistant.
#   disabled  (default) - endpoint returns 503
#   fake      - deterministic, development only (quotes context, not an AI)
#   anthropic - Claude (paid). Served ONLY when every production gate
#               passes: `python manage.py assistant_readiness`. API keys
#               alone never enable it.
OSUSU_LLM_PROVIDER=disabled
OSUSU_LLM_MODEL=                  # empty = claude-opus-5
OSUSU_LLM_API_KEY=
OSUSU_LLM_MAX_OUTPUT_TOKENS=4096  # thinking + answer; allowed 1024-16000
OSUSU_LLM_EFFORT=medium           # low | medium | high
OSUSU_LLM_TIMEOUT_SECONDS=60      # SDK retries twice: worst case ~3x this
OSUSU_LLM_REFUSAL_FALLBACK=default  # "off" disables server-side fallback

# Retrieval embeddings.
#   hashing (default) - local lexical stand-in, development/tests only
#   openai            - production model; requires OSUSU_EMBEDDING_API_KEY
#                       and an explicitly measured OSUSU_RAG_MIN_SIMILARITY
# Changing provider/model/dimensions makes existing vectors stale:
# re-run `python manage.py build_knowledge`.
OSUSU_EMBEDDING_PROVIDER=hashing
OSUSU_EMBEDDING_MODEL=text-embedding-3-small
OSUSU_EMBEDDING_DIMENSIONS=1536
OSUSU_EMBEDDING_API_KEY=
OSUSU_RAG_MIN_SIMILARITY=         # no default for openai; see evaluation/README.md

# Path to the live validation report (evaluation/README.md). Required
# before the paid assistant is served.
OSUSU_ASSISTANT_VALIDATION_REPORT=

# Assistant rate limiting (per user). Redis is REQUIRED with the paid
# provider (requests are refused otherwise); the in-memory limiter is
# per-process and for development only.
OSUSU_ASSISTANT_RATE_LIMIT=20
OSUSU_ASSISTANT_RATE_WINDOW_SECONDS=3600
OSUSU_RATE_LIMIT_REDIS_URL=       # e.g. redis://localhost:6379/1

# Opt-in tests that call real paid providers / a real Redis (never run by
# default).
# OSUSU_RUN_EXTERNAL_AI_TESTS=true
# OSUSU_RUN_REDIS_TESTS=true

# Optional: where trained ML models are stored (git-ignored).
# ML_MODEL_DIR=/path/to/ml_models
